# Hedera testnet operator account (https://portal.hedera.com)
OPERATOR_ID=0.0.xxxxxxx
OPERATOR_KEY=
NETWORK=testnet

# HCS topics (created with: npm run create-topic)
GAME_SESSION_TOPIC_ID=
LEADERBOARD_TOPIC_ID=

# API server
PORT=3001
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Smart contracts (addresses printed by the SmartContracts deploy scripts)
LEADERBOARD_CONTRACT_ADDRESS=
MARKETPLACE_CONTRACT_ADDRESS=
NFT_CONTRACT_ADDRESS=
# ECDSA key of the account allowed to call LeaderboardManager.submitSession
GAME_SERVER_PRIVATE_KEY=
HEDERA_RPC_URL=https://testnet.hashio.io/api

LOG_LEVEL=info
