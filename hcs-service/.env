# ========================================
# HEDERA TESTNET CREDENTIALS
# ========================================
# Get your credentials from: https://portal.hedera.com/register
# After registration, you'll receive:
# - Account ID (format: 0.0.XXXXXXX)
# - Private Key (DER-encoded hex string)

OPERATOR_ID=0.0.7298362
OPERATOR_KEY=3030020100300706052b8104000a0422042086c8aca6d19190024f65fe0809c91a0109697b043591e2d4bd9d74672f847278

# Network (testnet or mainnet)
NETWORK=testnet

# ========================================
# HCS TOPIC CONFIGURATION
# ========================================
# This will be filled after running: npm run create-topic
# Format: 0.0.XXXXXXX

GAME_SESSION_TOPIC_ID=0.0.7306772

# ========================================
# BACKEND API CONFIGURATION
# ========================================
# Port for the Express server
PORT=3001

# Allowed origins for CORS (comma-separated)
# Add your Angular app URLs here
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:8080

# ========================================
# OPTIONAL: MIRROR NODE (for reading)
# ========================================
# Hedera Mirror Node REST API
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ========================================
# LOGGING
# ========================================
# Log level: debug, info, warn, error
LOG_LEVEL=info